# =============================================================================
# Freebird Docker Quickstart Configuration
# =============================================================================
# Copy this file to `.env` and customize the values for your deployment.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker-compose up --build
#
# =============================================================================

# Docker Compose configuration
# Compose is an explicit direct-development deployment. It does not provide a
# trusted reverse proxy or a production TLS boundary.
DEPLOYMENT_MODE=development
# docker-compose.yaml sets COMPOSE_DIRECT_ONLY=true; do not change the mode
# to trusted-proxy/production without adding and reviewing a proxy service.
# These floating defaults are for the direct-development Compose quickstart
# only. Production operators must supply release-verified @sha256: image pins;
# no GHCR digest is invented in this example.
ISSUER_IMAGE=ghcr.io/flammafex/freebird-issuer:latest
VERIFIER_IMAGE=ghcr.io/flammafex/freebird-verifier:latest
# Host-published addresses. These are distinct from the in-container listeners.
ISSUER_HOST_BIND_ADDR=127.0.0.1:8081
VERIFIER_HOST_BIND_ADDR=127.0.0.1:8082
VERIFIER_EPOCH_DURATION_SEC=86400
VERIFIER_EPOCH_RETENTION=2

# =============================================================================
# ISSUER CONFIGURATION
# =============================================================================

# Unique identifier for this issuer (appears in tokens)
ISSUER_ID=issuer:docker:v4

# In-container server bind address (use 0.0.0.0 to listen on the container network)
ISSUER_BIND_ADDR=0.0.0.0:8081

# TLS enforcement. Keep false only for local Docker development; production
# traffic must terminate TLS at a trusted reverse proxy.
REQUIRE_TLS=false

# Set to true if running behind a reverse proxy (for proper client IP detection)
BEHIND_PROXY=false
# Required when BEHIND_PROXY=true; comma-separated proxy CIDRs.
TRUSTED_PROXY_CIDRS=

# -----------------------------------------------------------------------------
# Admin API Configuration
# -----------------------------------------------------------------------------
# REQUIRED for admin endpoints (user management, stats, key rotation)
# Must be at least 32 characters
# SECURITY: Change this in production! Use a secrets manager.
ADMIN_API_KEY=dev-admin-key-must-be-at-least-32-characters-long

# -----------------------------------------------------------------------------
# Key Storage Paths (mounted in Docker volumes)
# -----------------------------------------------------------------------------
ISSUER_SK_PATH=/data/keys/issuer_sk.bin
KEY_ROTATION_STATE_PATH=/data/keys/key_rotation_state.json
AUDIT_LOG_PATH=/data/audit_log.json

# -----------------------------------------------------------------------------
# Epoch Configuration (Key Rotation)
# -----------------------------------------------------------------------------
# V4 rotation is unsafe for production until Phase C. Keep the issuer key and
# matching verifier key stable; these settings are transitional only.
# Duration of each epoch (supports human-readable: 1d, 24h, etc.)
# Default: 1d (1 day = 86400 seconds)
EPOCH_DURATION=1d

# Number of previous epochs to accept (default: 2)
EPOCH_RETENTION=2

# -----------------------------------------------------------------------------
# Sybil Resistance Configuration
# -----------------------------------------------------------------------------
# Salts are auto-generated with secure random values if not explicitly set.
# For production, set explicit salts to ensure consistency across restarts.
# Options: none, invitation, pow, rate_limit, progressive_trust,
#          proof_of_diversity, multi_party_vouching, social_graph,
#          webauthn, combined
SYBIL_RESISTANCE=invitation

# --- Invitation System (only applies if SYBIL_RESISTANCE=invitation) ---
# Number of invitations each user can send
SYBIL_INVITE_PER_USER=5

# Cooldown between sending invitations (supports: 1h, 30m, 3600, etc.)
SYBIL_INVITE_COOLDOWN=1h

# Invitation expiration time (supports: 30d, 720h, etc.)
SYBIL_INVITE_EXPIRES=30d

# Wait time before new users can send invitations
SYBIL_INVITE_NEW_USER_WAIT=30d

# Path to invitations persistence file
SYBIL_INVITE_PERSISTENCE_PATH=/data/state/invitations.json

# Autosave interval
SYBIL_INVITE_AUTOSAVE_INTERVAL=5m

# Bootstrap users (format: "username:invite_count,username2:invite_count2")
# These users start with invitations available
SYBIL_INVITE_BOOTSTRAP_USERS=admin:100

# --- Proof of Work (only applies if SYBIL_RESISTANCE=pow) ---
# SYBIL_POW_DIFFICULTY=20

# --- Rate Limiting (only applies if SYBIL_RESISTANCE=rate_limit) ---
# SYBIL_RATE_LIMIT=1h

# --- Progressive Trust (only applies if SYBIL_RESISTANCE=progressive_trust) ---
# Format: "min_age:max_tokens:cooldown" - age and cooldown support human-readable durations
# SYBIL_PROGRESSIVE_TRUST_LEVELS=0:1:1d,30d:10:1h,90d:100:1m
# SYBIL_PROGRESSIVE_TRUST_PERSISTENCE_PATH=/data/state/progressive_trust.json
# SYBIL_PROGRESSIVE_TRUST_AUTOSAVE=5m
# SYBIL_PROGRESSIVE_TRUST_SALT=change-in-production

# --- Proof of Diversity (only applies if SYBIL_RESISTANCE=proof_of_diversity) ---
# SYBIL_PROOF_OF_DIVERSITY_MIN_SCORE=40
# SYBIL_PROOF_OF_DIVERSITY_PERSISTENCE_PATH=/data/state/proof_of_diversity.json
# SYBIL_PROOF_OF_DIVERSITY_AUTOSAVE=5m
# SYBIL_PROOF_OF_DIVERSITY_SECRET=change-me-or-set-secret-path
# SYBIL_PROOF_OF_DIVERSITY_SECRET_PATH=/data/state/proof_of_diversity_secret.bin
# SYBIL_PROOF_OF_DIVERSITY_SALT=change-in-production
# SYBIL_PROOF_OF_DIVERSITY_ALLOW_INSECURE=false  # local testing only

# --- Multi-Party Vouching (only applies if SYBIL_RESISTANCE=multi_party_vouching) ---
# SYBIL_MULTI_PARTY_VOUCHING_REQUIRED=3
# SYBIL_MULTI_PARTY_VOUCHING_COOLDOWN=1h
# SYBIL_MULTI_PARTY_VOUCHING_EXPIRES=30d
# SYBIL_MULTI_PARTY_VOUCHING_NEW_USER_WAIT=30d
# SYBIL_MULTI_PARTY_VOUCHING_PERSISTENCE_PATH=/data/state/multi_party_vouching.json
# SYBIL_MULTI_PARTY_VOUCHING_AUTOSAVE=5m
# SYBIL_MULTI_PARTY_VOUCHING_SECRET=change-me-or-set-secret-path
# SYBIL_MULTI_PARTY_VOUCHING_SECRET_PATH=/data/state/multi_party_vouching_secret.bin
# SYBIL_MULTI_PARTY_VOUCHING_SALT=change-in-production
# SYBIL_MULTI_PARTY_VOUCHING_ALLOW_INSECURE=false  # local testing only

# --- Social Graph (only applies if SYBIL_RESISTANCE=social_graph) ---
# Requires a separate Social Graph Attester service and accepted policy IDs.
# Path to trusted attester public keys JSON.
# SOCIAL_GRAPH_ATTESTERS_PATH=/data/config/social_graph_attesters.json
# Optional JWKS URL for attester keys. Key refresh is not yet implemented.
# SOCIAL_GRAPH_JWKS_URL=https://attester.example.org/.well-known/jwks.json
# Attester key refresh interval.
# SOCIAL_GRAPH_KEY_REFRESH_INTERVAL=1h
# Minimum eligibility level: 1=basic, 2=standard, 3=high-value.
# SOCIAL_GRAPH_MIN_LEVEL=1
# Comma-separated accepted attester policy IDs. Required; do not leave empty.
# SOCIAL_GRAPH_ACCEPTED_POLICY_IDS=clout-trust-v1
# Maximum attestation age.
# SOCIAL_GRAPH_ATTESTATION_MAX_AGE=5m
# Allowed clock skew.
# SOCIAL_GRAPH_CLOCK_SKEW_SECS=30s
# Require Cred presentation request binding to match this issuance request.
# SOCIAL_GRAPH_REQUIRE_REQUEST_BINDING=true
# Require and replay-check an epoch-scoped quota nullifier.
# SOCIAL_GRAPH_REQUIRE_QUOTA_NULLIFIER=false
# Replay store TTL for attestation jti and optional quota nullifier.
# SOCIAL_GRAPH_REPLAY_TTL=10m
# Persistent social graph state path.
# SOCIAL_GRAPH_STATE_PATH=/data/state/social_graph_state.json
# Fail closed when trusted attester keys are unavailable.
# SOCIAL_GRAPH_FAIL_CLOSED=true

# -----------------------------------------------------------------------------
# WebAuthn Configuration (requires feature flag "human-gate-webauthn")
# -----------------------------------------------------------------------------
# Uncomment and configure if using WebAuthn for Proof of Humanity
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Freebird
# WEBAUTHN_RP_ORIGIN=http://localhost:8081
# WEBAUTHN_REDIS_URL=redis://redis:6379
# WEBAUTHN_CRED_TTL=1d
# WEBAUTHN_MAX_PROOF_AGE=1h

# -----------------------------------------------------------------------------
# HSM Configuration (Hardware Security Module)
# -----------------------------------------------------------------------------
# HSM startup integration is not implemented. HSM_ENABLE=true is rejected by
# issuer startup and freebird-validate-config until provider integration exists.
# Keep HSM disabled; the optional PKCS#11 provider remains available for its
# separately scoped provider-level tests.
# HSM_ENABLE=false
# HSM_MODE=storage                 # reserved for future issuer integration
# HSM_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
# HSM_SLOT=0
# HSM_PIN=1234
# HSM_KEY_LABEL=freebird-voprf-key

# -----------------------------------------------------------------------------
# V5 Public Bearer Pass Configuration
# -----------------------------------------------------------------------------
# Enabled by default. V5 uses RFC 9474 blind RSA signatures and issuer-published
# public key metadata. Rotate the key and metadata together when changing policy.
PUBLIC_BEARER_ENABLE=true
PUBLIC_BEARER_SK_PATH=/data/keys/public_bearer_sk.der
PUBLIC_BEARER_METADATA_PATH=/data/keys/public_bearer_metadata.json
PUBLIC_BEARER_VALIDITY=30d
PUBLIC_BEARER_MODULUS_BITS=2048
# Optional audience binding for V5 public bearer passes:
# PUBLIC_BEARER_AUDIENCE=docker

# ----------------------------------------------------------------------------
# Public bearer exchange V2 graph (public API; disabled by default)
# ----------------------------------------------------------------------------
# Fresh-install, breaking V2 scope only: there is no V1 exchange configuration,
# endpoint, or Redis-state migration. Start with a Redis logical database empty
# of old exchange records. See docs/public-bearer-exchange.md before enabling.
# PUBLIC_BEARER_EXCHANGE_ENABLE=false
# This MUST be the same Redis logical database configured as REDIS_URL on every
# participating verifier. URL string equality is not required or proof; the
# verifier proves the shared authority with a bidirectional probe. This is the
# issuer/verifier V5 spend authority, not a cache. Require one standalone
# writable master with appendonly=yes,
# appendfsync=always, maxmemory-policy=noeviction, and healthy AOF writes.
# PUBLIC_BEARER_EXCHANGE_REDIS_URL=redis://redis:6379
# Locally pinned strict V2 graph; never fetch operator configuration at runtime.
# It declares role-neutral descriptors/keysets and directed transitions with
# canonical IDs, explicit admission states, and non-reusable lifetime budgets.
# PUBLIC_BEARER_EXCHANGE_ACTIVE_GRAPH_PATH=/data/config/public-bearer-exchange-graph-v2.json
# Comma-separated prior graphs. Retained transitions must be recovery_only or
# disabled; retain private output signers until pending references reach zero.
# PUBLIC_BEARER_EXCHANGE_RETAINED_GRAPH_PATHS=/data/config/exchange-graph-previous.json
# Public-only retained graphs and receipt verification keys. It must contain no
# private paths, operation data, artifacts, nullifiers, or status capabilities.
# Keep registry identities present permanently and public verification material
# through the inclusive expiry of every corresponding artifact and receipt.
# PUBLIC_BEARER_EXCHANGE_PUBLIC_HISTORY_PATH=/data/config/exchange-public-history-v2.json
# Before any transition is accepting_new, provide strict operator acknowledgement
# files proving its disabled publication was reviewed. Comma-separate paths.
# PUBLIC_BEARER_EXCHANGE_DISABLED_PUBLICATION_ACK_PATHS=/data/config/exchange-publication-ack.json
# Active Ed25519 receipt seed and its separately pinned public metadata. The key
# must already exist, match the metadata, be a regular non-symlink 0600 file,
# and remain valid for the complete configured receipt lifetime.
# PUBLIC_BEARER_EXCHANGE_ACTIVE_RECEIPT_KEY_PATH=/data/keys/exchange-receipt-active.key
# PUBLIC_BEARER_EXCHANGE_ACTIVE_RECEIPT_METADATA_PATH=/data/config/exchange-receipt-active.json
# Retained seed and metadata lists are positional and must have equal counts.
# Keep private receipt signers until pending references reach zero; then move
# their public verification metadata to public history before retiring them.
# PUBLIC_BEARER_EXCHANGE_RETAINED_RECEIPT_KEY_PATHS=/data/keys/exchange-receipt-previous.key
# PUBLIC_BEARER_EXCHANGE_RETAINED_RECEIPT_METADATA_PATHS=/data/config/exchange-receipt-previous.json
# V2 routes are POST /v2/public/exchange and GET /v2/public/exchange/status.
# Requests carry a public 16-byte operation ID; both routes require a distinct,
# private, canonical 32-byte base64url Exchange-Status-Capability header.
# PUBLIC_BEARER_EXCHANGE_RECEIPT_LIFETIME=1d
# PUBLIC_BEARER_EXCHANGE_MAX_BODY_BYTES=3145728
# PUBLIC_BEARER_EXCHANGE_TIMEOUT=30s

# ----------------------------------------------------------------------------
# Policy-authorized graph blind issuance V2 (disabled by default)
# ----------------------------------------------------------------------------
# Creates the first V5 artifact under an explicitly issuance-enabled active
# graph descriptor. This is not exchange and uses separate authorization and
# lifetime-budget Redis namespaces. It requires exchange graph configuration.
# This coordination flag must be true in the issuer and every participating
# verifier environment; otherwise the verifier must remain fail-closed with no
# graph authority URL. Compose passes this shared .env to both services.
# PUBLIC_BEARER_GRAPH_ISSUANCE_ENABLE=false
# PUBLIC_BEARER_GRAPH_ISSUANCE_POLICY_PATH=/data/config/graph-issuance-policy-v2.json
# Production verifier. The canonical base64url secret must contain >=32 random
# bytes and should be injected by a secrets manager, never put in discovery.
# PUBLIC_BEARER_GRAPH_ISSUANCE_AUTHORIZATION=hmac_sha256
# PUBLIC_BEARER_GRAPH_ISSUANCE_HMAC_SECRET_B64=<canonical-base64url-secret>
# Approved local V4 credential mode. The keyring is issuer-local secret
# configuration; shared Redis authority is proven by the verifier probe.
# PUBLIC_BEARER_GRAPH_ISSUANCE_AUTHORIZATION=v4_local
# Strict secret JSON: issuer ID -> key ID -> canonical base64url VOPRF key.
# PUBLIC_BEARER_GRAPH_ISSUANCE_V4_KEYRING_B64='{"issuer:docker:v4":{"<kid>":"<base64url-32-byte-key>"}}'
# The mock verifier requires FREEBIRD_ENV=development,
# FREEBIRD_UNSAFE_DEVELOPMENT_MODE=true, and this additional explicit fence.
# PUBLIC_BEARER_GRAPH_ISSUANCE_ALLOW_DEVELOPMENT_MOCK=false

# =============================================================================
# VERIFIER CONFIGURATION
# =============================================================================

# In-container server bind address
VERIFIER_BIND_ADDR=0.0.0.0:8082

# Issuer metadata URL (use Docker service name for internal network)
ISSUER_URL=http://issuer:8081/.well-known/issuer

# Optional V2 graph-issuance authority URLs for participating V4 verifiers.
# These URLs are used for /.well-known/keys and the fixed probe route; they are
# not inferred from ISSUER_URL and must reach the same logical Redis database
# as the issuer. Leave empty when graph issuance is disabled.
# VERIFIER_GRAPH_ISSUANCE_ISSUER_URLS=https://issuer.example.org
VERIFIER_REPLAY_AUTHORITY_PROBE_INTERVAL=30s
VERIFIER_REPLAY_AUTHORITY_MAX_STALENESS=60s

# Verifier scope. Clients bind this scope into every V4 token before issuance.
VERIFIER_ID=verifier:docker:v4
VERIFIER_AUDIENCE=docker
VERIFIER_ACCEPTED_TOKEN_VERSIONS=v4,v5
VERIFIER_ENV=development
IN_MEMORY_REPLAY_STORE=false


# Issuer metadata refresh interval in minutes
REFRESH_INTERVAL_MIN=10

# Redis URL for nullifier storage (production required). When public bearer
# exchange or V2 graph issuance is enabled, this value and
# PUBLIC_BEARER_EXCHANGE_REDIS_URL must name the same logical database so issuer
# spends and verifier replays are atomic. The authority probe proves this;
# configured URL equality is obsolete and must not be used as a check.
# Required for verifier replay protection. In-memory storage is development-only
# and requires both IN_MEMORY_REPLAY_STORE=true and VERIFIER_ENV=development.
REDIS_URL=redis://redis:6379
SYBIL_REPLAY_STORE=redis
SYBIL_REPLAY_REDIS_URL=redis://redis:6379

# Epoch configuration (should match issuer settings)
# Note: the verifier uses EPOCH_DURATION_SEC (integer seconds), not EPOCH_DURATION
EPOCH_DURATION_SEC=86400
EPOCH_RETENTION=2

# V4 private verification key material.
# Required for V4 private tokens. V5 public bearer tokens use issuer-published
# public keys from /.well-known/keys and do not need these verifier secrets.
VERIFIER_SK_PATH=/issuer-data/keys/issuer_sk.bin
# VERIFIER_SK_B64=<base64url-raw-32-byte-key>
# VERIFIER_KEYRING_B64='{"kid-1":"<base64url-key>"}'

# -----------------------------------------------------------------------------
# Admin API Configuration
# -----------------------------------------------------------------------------
# REQUIRED for admin endpoints (stats, health checks)
# Must be at least 32 characters
# SECURITY: Change this in production! Use a secrets manager.
ADMIN_API_KEY=dev-admin-key-must-be-at-least-32-characters-long

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (options: trace, debug, info, warn, error)
# Format: "level" or "level,module=level" for granular control
# Examples:
#   RUST_LOG=info                          # All modules at info level
#   RUST_LOG=debug                         # All modules at debug level
#   RUST_LOG=info,freebird=debug           # Freebird at debug, others at info
#   RUST_LOG=info,axum=warn,tower_http=off # Fine-grained control
RUST_LOG=info,freebird=debug

# Log format (options: plain, json)
LOG_FORMAT=plain

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# VALIDATE CONFIGURATION:
#   Before starting the issuer, validate your configuration:
#     source .env && freebird-validate-config
#
#   This will check for common configuration errors and missing files.
#
# DURATION FORMAT:
#   Most duration fields support human-readable formats:
#     - 30d  = 30 days
#     - 24h  = 24 hours
#     - 30m  = 30 minutes
#     - 45s  = 45 seconds
#     - 1d12h = 1 day and 12 hours (combined)
#     - 3600  = raw seconds
#
# DEVELOPMENT:
#   - Use the defaults provided above
#   - SYBIL_RESISTANCE=invitation with bootstrap users works well
#   - For unsafe local testing only, set IN_MEMORY_REPLAY_STORE=true while
#     keeping VERIFIER_ENV=development; never use this in production.
#
# PRODUCTION:
#   - CHANGE ADMIN_API_KEY to a secure random value (use secrets manager)
#   - CHANGE all default salts (SYBIL_*_SALT variables)
#   - Set REQUIRE_TLS=true
#   - Set BEHIND_PROXY=true if using a reverse proxy
#   - Use REDIS_URL for persistent verifier nullifier storage and
#     SYBIL_REPLAY_REDIS_URL for issuer replay protection
#   - Deploy issuer and verifier on separate infrastructure
#   - Use proper TLS certificates (not self-signed)
#   - Protect key files with encrypted volumes or a secret manager
#
# DEBUGGING:
#   - Set RUST_LOG=debug or RUST_LOG=trace for verbose logging
#   - Check Docker logs: docker-compose logs -f issuer
#   - Verify connectivity: curl http://localhost:8081/.well-known/issuer
#
# =============================================================================
