{
  "name": "@flammafex/freebird",
  "version": "0.10.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Anonymous authentication using VOPRF (Freebird SDK)",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://git.carpocratian.org/sibyl/freebird.git"
  },
  "homepage": "https://git.carpocratian.org/sibyl/freebird",
  "keywords": [
    "freebird",
    "voprf",
    "anonymous",
    "authentication",
    "privacy",
    "token",
    "blind-signature"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@cloudflare/blindrsa-ts": "^0.4.6",
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.0",
    "lossless-json": "^4.3.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsup": "^7.2.0",
    "vitest": "^0.34.0",
    "ws": "^8.18.3"
  },
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "author": ""
}
