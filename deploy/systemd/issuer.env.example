# Copy to /etc/freebird/issuer.env, chmod 0640, owned by root:freebird.
# Replace all example secrets and hostnames before starting the service.

RUST_LOG=info,freebird=debug
BIND_ADDR=127.0.0.1:8081
REQUIRE_TLS=true
BEHIND_PROXY=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32

ADMIN_API_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
ISSUER_ID=issuer:example:v4
ISSUER_SK_PATH=/var/lib/freebird/issuer/keys/issuer_sk.bin
KEY_ROTATION_STATE_PATH=/var/lib/freebird/issuer/keys/key_rotation_state.json
AUDIT_LOG_PATH=/var/lib/freebird/issuer/audit_log.json

NATIVE_BEARER_V7_ENABLE=true
NATIVE_BEARER_V7_SK_PATH=/var/lib/freebird/issuer/keys/native_bearer_v7.der
NATIVE_BEARER_V7_METADATA_PATH=/var/lib/freebird/issuer/config/native_bearer_v7.json
NATIVE_BEARER_V7_REGISTRY_PATH=/var/lib/freebird/issuer/config/native_bearer_v7_registry.json
NATIVE_BEARER_V7_PROFILE_ID=scarcity/native-bearer/v7
NATIVE_BEARER_V7_DESCRIPTOR_ID=<64-lowercase-hex>
NATIVE_BEARER_V7_TOKEN_KEY_ID=<64-lowercase-hex>
NATIVE_BEARER_V7_ASSET_ID=USD
NATIVE_BEARER_V7_AMOUNT_MINOR=1
NATIVE_BEARER_V7_VALIDITY=30d

REDIS_URL=redis://127.0.0.1:6379
SYBIL_REPLAY_STORE=redis
SYBIL_REPLAY_REDIS_URL=redis://127.0.0.1:6379

# Optional native V7 exchange/graph issuance. Leave disabled until all V7
# discovery, history, receipt, policy, and signer files are installed and
# freebird-validate-config passes.
NATIVE_EXCHANGE_V7_ENABLE=false
NATIVE_EXCHANGE_V7_REDIS_URL=redis://127.0.0.1:6379
NATIVE_EXCHANGE_V7_DISCOVERY_PATH=/var/lib/freebird/issuer/config/native-exchange-v7-discovery.json
NATIVE_EXCHANGE_V7_RETAINED_DISCOVERY_PATHS=
NATIVE_EXCHANGE_V7_PUBLIC_HISTORY_PATH=/var/lib/freebird/issuer/config/native-exchange-v7-history.json
NATIVE_EXCHANGE_V7_DISABLED_PUBLICATION_ACK_PATHS=
NATIVE_EXCHANGE_V7_ACTIVE_RECEIPT_KEY_PATH=/var/lib/freebird/issuer/keys/native-exchange-v7-receipt.key
NATIVE_EXCHANGE_V7_ACTIVE_RECEIPT_METADATA_PATH=/var/lib/freebird/issuer/config/native-exchange-v7-receipt.json
NATIVE_EXCHANGE_V7_RETAINED_RECEIPT_KEY_PATHS=
NATIVE_EXCHANGE_V7_RETAINED_RECEIPT_METADATA_PATHS=
NATIVE_EXCHANGE_V7_RECEIPT_LIFETIME=1d
NATIVE_EXCHANGE_V7_MAX_BODY_BYTES=3145728
NATIVE_EXCHANGE_V7_TIMEOUT=30s
NATIVE_GRAPH_ISSUANCE_V7_ENABLE=false
NATIVE_GRAPH_ISSUANCE_V7_POLICY_PATH=/var/lib/freebird/issuer/config/native-graph-issuance-v7-discovery.json
NATIVE_GRAPH_ISSUANCE_V7_AUTHORIZATION=v4_local
NATIVE_GRAPH_ISSUANCE_V7_VERIFIER_ID=verifier:example:v4
NATIVE_GRAPH_ISSUANCE_V7_AUDIENCE=freebird-native-graph-v7
# Set the issuer-local V4 keyring when native V7 graph issuance is enabled:
# NATIVE_GRAPH_ISSUANCE_V7_V4_KEYRING_B64=<issuer-local-secret-json>

SYBIL_RESISTANCE=invitation
SYBIL_INVITE_PER_USER=5
SYBIL_INVITE_COOLDOWN=1h
SYBIL_INVITE_EXPIRES=30d
SYBIL_INVITE_NEW_USER_WAIT=30d
SYBIL_INVITE_PERSISTENCE_PATH=/var/lib/freebird/issuer/state/invitations.json
SYBIL_INVITE_AUTOSAVE_INTERVAL=5m
SYBIL_INVITE_SIGNING_KEY_PATH=/var/lib/freebird/issuer/keys/invitation_signing_key.bin
SYBIL_INVITE_BOOTSTRAP_USERS=admin:100

# WebAuthn (enabled by setting WEBAUTHN_RP_ID and WEBAUTHN_RP_ORIGIN)
# SYBIL_RESISTANCE=webauthn
# WEBAUTHN_RP_ID=issuer.example.org
# WEBAUTHN_RP_ORIGIN=https://issuer.example.org
# WEBAUTHN_PROOF_SECRET=CHANGE_ME_RANDOM_SECRET
# WEBAUTHN_REDIS_URL=redis://127.0.0.1:6379
# WEBAUTHN_REQUIRE_ATTESTATION=true
# WEBAUTHN_ATTESTATION_POLICY=direct
# WEBAUTHN_ALLOWED_AAGUIDS=

# HSM startup integration is not implemented. HSM_ENABLE=true is rejected by
# the issuer and freebird-validate-config until provider integration exists.
# Keep HSM disabled; the settings below are reserved for future integration and
# provider-level PKCS#11 testing only.
HSM_ENABLE=false
# HSM_MODE=storage
# HSM_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
# HSM_SLOT=0
# HSM_PIN=CHANGE_ME
# HSM_KEY_LABEL=freebird-voprf-key
