# Copy to /etc/freebird/verifier.env, chmod 0640, owned by root:freebird.
# Replace all example secrets and hostnames before starting the service.

RUST_LOG=info,freebird=debug
BIND_ADDR=127.0.0.1:8082
REQUIRE_TLS=true
BEHIND_PROXY=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32

ADMIN_API_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
VERIFIER_ID=verifier:example:v4
VERIFIER_AUDIENCE=example
VERIFIER_ACCEPTED_TOKEN_VERSIONS=v4,v7
VERIFIER_ENV=production
IN_MEMORY_REPLAY_STORE=false
ISSUER_URL=https://issuer.example.org/.well-known/issuer
VERIFIER_SK_PATH=/var/lib/freebird/verifier/keys/issuer_sk.bin

# ISSUER_URL supplies strict V7 GET /.well-known/keys discovery (the verifier
# normalizes the configured issuer metadata URL to that path). Set these when
# this verifier participates in V7 graph issuance. The graph-authority URL below
# supplies only V4 GET /.well-known/replay-authority metadata for verifier health
# refresh plus the separate POST /v1/public/graph/replay-authority/probe. It does
# not supply V7 keys. It must reach the same Redis logical database as REDIS_URL;
# URL equality is not proof. Leave empty when graph issuance is disabled.
NATIVE_GRAPH_ISSUANCE_V7_ENABLE=false
VERIFIER_GRAPH_ISSUANCE_ISSUER_URLS=
VERIFIER_REPLAY_AUTHORITY_PROBE_INTERVAL=30s
VERIFIER_REPLAY_AUTHORITY_MAX_STALENESS=60s

REDIS_URL=redis://127.0.0.1:6379
REFRESH_INTERVAL_MIN=10
EPOCH_DURATION_SEC=86400
EPOCH_RETENTION=2
