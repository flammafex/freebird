# Freebird Issuer Configuration - HSM Integration Placeholder
#
# Issuer startup HSM integration is not implemented. HSM_ENABLE=true is
# rejected by both the issuer and freebird-validate-config. Do not use this
# file to enable HSM-backed issuer operation; the settings below are reserved
# for a future integration and provider-level PKCS#11 testing only.

# Issuer Configuration
ISSUER_ID=issuer:freebird:hsm:v1
BIND_ADDR=0.0.0.0:8081
REQUIRE_TLS=false
BEHIND_PROXY=false
TRUSTED_PROXY_CIDRS=

# Epoch Configuration (for key rotation)
EPOCH_DURATION=1d         # 1 day
EPOCH_RETENTION=2         # Accept tokens from 2 previous epochs

# HSM Configuration (disabled until issuer startup integration exists)
HSM_ENABLE=false

# Reserved HSM mode. Neither mode is available through issuer startup.
# HSM_MODE=storage

# PKCS#11 Module Path (depends on HSM type)
# SoftHSM (for testing):
HSM_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
# YubiHSM:
# HSM_MODULE_PATH=/usr/lib/libykcs11.so
# Nitrokey HSM (via OpenSC):
# HSM_MODULE_PATH=/usr/lib/x86_64-linux-gnu/opensc-pkcs11.so

# HSM Slot Number
# Use 'pkcs11-tool --module <path> --list-slots' to find available slots
HSM_SLOT=0

# HSM PIN
# WARNING: In production, use a secrets manager instead of .env file
HSM_PIN=1234

# Key Label in HSM
# This is the label assigned to the P-256 key in the HSM
HSM_KEY_LABEL=freebird-voprf-key

# Software key storage used by the issuer while HSM startup integration is
# unavailable.
ISSUER_SK_PATH=issuer_sk.bin
KEY_ROTATION_STATE_PATH=key_rotation_state.json

# Sybil Resistance (optional)
SYBIL_RESISTANCE=none
# Options: none, invitation, pow, rate_limit, combined

# Admin API (optional)
# ADMIN_API_KEY=your-secret-admin-key-here
